<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zeroshot-dotnet</AssemblyName>
    <RootNamespace>Zeroshot.Cli</RootNamespace>
    <PackageId>Zeroshot.Cli</PackageId>
    <Version>0.1.0-preview.1</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zeroshot-dotnet</ToolCommandName>
    <Description>Locally built zeroshot-dotnet command over the Zeroshot.Client SDK.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Zeroshot.Sdk/Zeroshot.Sdk.csproj" />
  </ItemGroup>

</Project>
