<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Zeroshot.Client</AssemblyName>
    <RootNamespace>Zeroshot</RootNamespace>
    <PackageId>Zeroshot.Client</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Native Zeroshot 10.9.0 execution contracts, exact prepared submissions, bounded HTTP operations, and correlated WebSocket OECP inspection and watch/log subscriptions, discovered run history, browser dashboard routes, and ZeroshotClient run handles with local preparation, caller-supplied native binding checks, status results, terminal waits, force-stop and live attachment.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <EmbeddedResource Include="Schemas/*.json" />
    <None Include="../../docs/contracts/README.md" Pack="true" PackagePath="/" />
    <None Include="Schemas/NATIVE-LICENSE" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
  <!-- The declared public API (README "Release qualification"): an undeclared, removed or differently annotated public
       symbol fails the build. Shipped holds the API released so far (moved there with the release tag); Unshipped what the next
       release adds. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0036;RS0037</WarningsAsErrors>
    <!-- Overload design advice for an already accepted surface, not API tracking. -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
